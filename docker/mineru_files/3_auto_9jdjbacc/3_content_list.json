            659
        ],
        "page_idx": 1
    },
    {
        "type": "list",
        "sub_type": "text",
        "list_items": [
            "- 发出成本  $= 50 \\times 20 + 70 \\times 22 = 1000 + 1540 = 2540$  元",
            "期末库存成本  $= (100 - 70)\\times 22 + 80\\times 25 = 660 + 2000 = 2660$  元"
        ],
        "bbox": [
            174,
            676,
            759,
            723
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "例题2：月末一次加权平均法",
        "text_level": 1,
        "bbox": [
            144,
            738,
            394,
            754
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "沿用例题1B材料数据（3月无其他收发）",
        "bbox": [
            144,
            769,
            504,
            786
        ],
        "page_idx": 1
    },
    {
        "type": "list",
        "sub_type": "text",
        "list_items": [
