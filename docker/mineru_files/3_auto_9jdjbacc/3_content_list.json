            448,
            319,
            465
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "甲公司B材料收发存数据：",
        "bbox": [
            146,
            479,
            371,
            496
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "日期业务数量（kg）单价（元/kg）成本（元）",
        "text_level": 1,
        "bbox": [
            149,
            511,
            546,
            529
        ],
        "page_idx": 1
    },
    {
        "type": "list",
        "sub_type": "text",
        "list_items": [
            "3.1 期初50 20 1000",
            "3.5 购入100 22 2200",
            "3.10发出120",
            "3.15购入80 25 2000"
        ],
        "bbox": [
