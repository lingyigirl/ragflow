        "bbox": [
            176,
            634,
            305,
            650
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "$\\mathrm{k}$  的符号图像位置 增减性",
        "text_level": 1,
        "bbox": [
            206,
            665,
            460,
            683
        ],
        "page_idx": 1
    },
    {
        "type": "text",
        "text": "k>0 第一、三象限在每个象限内，y随x的增大而减小",
        "bbox": [
            206,
