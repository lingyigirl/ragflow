        "bbox": [
            144,
            793,
            194,
            808
        ],
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "解不等式  $x2 - 3x + 2 > 0$  ，得  $x < 1$  或  $x > 2$  。",
        "bbox": [
